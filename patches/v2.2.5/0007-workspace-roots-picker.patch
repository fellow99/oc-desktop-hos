diff --git a/packages/app/src/workspaces/selection/roots.test.ts b/packages/app/src/workspaces/selection/roots.test.ts
new file mode 100644
index 0000000000..3d9f5f6a54
--- /dev/null
+++ b/packages/app/src/workspaces/selection/roots.test.ts
@@ -0,0 +1,221 @@
+import { describe, expect, test } from "bun:test"
+import {
+  clampToRoot,
+  crumbSegments,
+  defaultFolderName,
+  filterHiddenEntries,
+  isWithin,
+  normalizeRootPath,
+  readStoredRootId,
+  rootOf,
+  writeStoredRootId,
+  probeWorkspaceRoots,
+  mkdirInRoot,
+  ROOT_STORAGE_KEY,
+  type RootInfo,
+} from "./roots"
+
+const documents: RootInfo = {
+  id: "documents",
+  path: "/storage/Users/currentUser/Documents",
+  available: true,
+  reason: "",
+}
+const download: RootInfo = {
+  id: "download",
+  path: "/storage/Users/currentUser/Download",
+  available: true,
+  reason: "",
+}
+const desktopUnavailable: RootInfo = { id: "desktop", path: "", available: false, reason: "未授权" }
+const roots = [documents, download, desktopUnavailable]
+
+describe("normalizeRootPath", () => {
+  test("去尾部分隔符且保留根", () => {
+    expect(normalizeRootPath("/a/b/")).toBe("/a/b")
+    expect(normalizeRootPath("/a/b///")).toBe("/a/b")
+    expect(normalizeRootPath("/")).toBe("/")
+    expect(normalizeRootPath("")).toBe("")
+  })
+})
+
+describe("isWithin", () => {
+  test("包含自身与后代，拒绝同级与祖先", () => {
+    expect(isWithin("/a/b", "/a/b")).toBe(true)
+    expect(isWithin("/a/b", "/a/b/c")).toBe(true)
+    expect(isWithin("/a/b", "/a/bc")).toBe(false)
+    expect(isWithin("/a/b", "/a")).toBe(false)
+    expect(isWithin("/a/b", "/")).toBe(false)
+  })
+
+  test("尾部分隔符不影响判定", () => {
+    expect(isWithin("/a/b/", "/a/b/c/")).toBe(true)
+    expect(isWithin("/a/b", "/a/b/")).toBe(true)
+  })
+
+  test("分隔符无关：同侧与**混合**分隔符都判定为子路径（评审 Finding 1）", () => {
+    expect(isWithin("C:\\data\\Documents", "C:\\data\\Documents\\p1")).toBe(true)
+    expect(isWithin("C:/data/Documents", "C:/data/Documents/p1")).toBe(true)
+    expect(isWithin("C:\\data\\Documents", "C:/data/Documents/p1")).toBe(true)
+    expect(isWithin("C:\\data\\Documents", "C:\\data\\DocumentsX\\p1")).toBe(false)
+    expect(isWithin("C:\\data\\Documents", "C:/data/DocumentsX/p1")).toBe(false)
+  })
+
+  test("含 `..` 的相对段一律拒绝（字符串比较无法可靠判定其归属）", () => {
+    expect(isWithin("/a/b", "/a/b/../c")).toBe(false)
+    expect(isWithin("/a/../b", "/a/b/c")).toBe(false)
+    // `.` 段**不做**归一化（`navigate` 侧由上游 canonicalPickerPath 负责；树路径不含 `.` 段），
+    // 因此这里按字面比较即判为域外 —— 保守方向（宁拒绝不误放）。
+    expect(isWithin("/a/b", "/a/./b/c")).toBe(false)
+  })
+
+  test("空值一律不包含", () => {
+    expect(isWithin("", "/a")).toBe(false)
+    expect(isWithin("/a", "")).toBe(false)
+  })
+})
+
+describe("rootOf", () => {
+  test("最长前缀匹配且跳过不可用主目录", () => {
+    expect(rootOf("/storage/Users/currentUser/Documents/p1", roots)?.id).toBe("documents")
+    expect(rootOf("/storage/Users/currentUser/Download", roots)?.id).toBe("download")
+  })
+
+  test("不可用主目录不参与匹配", () => {
+    expect(rootOf("/storage/Users/currentUser/Desktop", roots)).toBeUndefined()
+  })
+
+  test("全部不匹配时返回 undefined", () => {
+    expect(rootOf("/", roots)).toBeUndefined()
+  })
+})
+
+describe("clampToRoot", () => {
+  test("域内保留、域外退回根", () => {
+    expect(clampToRoot(documents.path, "/storage/Users/currentUser/Documents/p1")).toBe(
+      "/storage/Users/currentUser/Documents/p1",
+    )
+    expect(clampToRoot(documents.path, "/storage/Users/currentUser")).toBe(documents.path)
+    expect(clampToRoot(documents.path, "/")).toBe(documents.path)
+  })
+})
+
+describe("defaultFolderName", () => {
+  test("无冲突时用默认名", () => {
+    expect(defaultFolderName([], "未命名文件夹")).toBe("未命名文件夹")
+    expect(defaultFolderName(["其它"], "未命名文件夹")).toBe("未命名文件夹")
+  })
+
+  test("同级冲突时按序号递增", () => {
+    expect(defaultFolderName(["未命名文件夹"], "未命名文件夹")).toBe("未命名文件夹 2")
+    expect(defaultFolderName(["未命名文件夹", "未命名文件夹 2"], "未命名文件夹")).toBe("未命名文件夹 3")
+  })
+
+  test("跳号也能取到未占用名", () => {
+    expect(defaultFolderName(["未命名文件夹", "未命名文件夹 3"], "未命名文件夹")).toBe("未命名文件夹 2")
+  })
+})
+
+describe("crumbSegments", () => {
+  test("从根到当前目录分段，不含根之上层级", () => {
+    expect(crumbSegments(documents.path, "/storage/Users/currentUser/Documents/a/b")).toEqual(["a", "b"])
+    expect(crumbSegments(documents.path, documents.path)).toEqual([])
+  })
+
+  test("域外路径返回空数组", () => {
+    expect(crumbSegments(documents.path, "/storage/Users/currentUser")).toEqual([])
+  })
+})
+
+describe("filterHiddenEntries", () => {
+  test("过滤以点开头的最后一段", () => {
+    expect(filterHiddenEntries(["a/", ".git/", "b/c/", "b/.hidden/"])).toEqual(["a/", "b/c/"])
+  })
+
+  test("保留非隐藏项与空输入", () => {
+    expect(filterHiddenEntries([])).toEqual([])
+    expect(filterHiddenEntries(["可见/"])).toEqual(["可见/"])
+  })
+})
+
+describe("主目录记忆", () => {
+  test("非法值与缺失一律回退 sandbox", () => {
+    expect(readStoredRootId({ getItem: () => null })).toBe("sandbox")
+    expect(readStoredRootId({ getItem: () => "not-a-root" })).toBe("sandbox")
+    expect(readStoredRootId({ getItem: () => "" })).toBe("sandbox")
+  })
+
+  test("合法值原样返回；写回使用私有键", () => {
+    expect(readStoredRootId({ getItem: () => "documents" })).toBe("documents")
+    const writes: Array<[string, string]> = []
+    writeStoredRootId("download", { setItem: (key, value) => void writes.push([key, value]) })
+    expect(writes).toEqual([[ROOT_STORAGE_KEY, "download"]])
+  })
+
+  test("存储抛错不影响本次会话", () => {
+    expect(
+      readStoredRootId({
+        getItem: () => {
+          throw new Error("denied")
+        },
+      }),
+    ).toBe("sandbox")
+    expect(() =>
+      writeStoredRootId("sandbox", {
+        setItem: () => {
+          throw new Error("denied")
+        },
+      }),
+    ).not.toThrow()
+  })
+})
+
+describe("能力 RPC 封装", () => {
+  const sdkWith = (call: (input: unknown) => Promise<{ output?: unknown }>) => ({ api: { rpc: { call } } })
+
+  test("roots 形状不符或调用失败时返回 undefined（自门控回退上游）", async () => {
+    expect(await probeWorkspaceRoots(sdkWith(async () => ({ output: undefined })))).toBeUndefined()
+    expect(await probeWorkspaceRoots(sdkWith(async () => ({ output: { home: "", roots: [] } })))).toBeUndefined()
+    expect(
+      await probeWorkspaceRoots(
+        sdkWith(async () => {
+          throw new Error("rpc.unavailable")
+        }),
+      ),
+    ).toBeUndefined()
+  })
+
+  test("roots 正常时归一化为 RootSet", async () => {
+    const result = await probeWorkspaceRoots(
+      sdkWith(async () => ({
+        output: {
+          home: "/storage/Users/currentUser",
+          roots: [
+            { id: "sandbox", path: "/data/storage/el2/base/files/workspace", available: true, reason: "" },
+            { id: "unknown", path: "/x", available: true, reason: "" },
+          ],
+        },
+      })),
+    )
+    expect(result?.home).toBe("/storage/Users/currentUser")
+    expect(result?.roots.map((root) => root.id)).toEqual(["sandbox"])
+  })
+
+  test("mkdir 失败降级为结构化错误（不抛错）", async () => {
+    const out = await mkdirInRoot(sdkWith(async () => ({ output: { ok: false, code: "out-of-root", message: "越界", path: "" } })), {
+      id: "documents",
+      parent: "/a",
+      name: "x",
+    })
+    expect(out).toEqual({ ok: false, code: "out-of-root", message: "越界", path: "" })
+
+    const thrown = await mkdirInRoot(
+      sdkWith(async () => {
+        throw new Error("boom")
+      }),
+      { id: "documents", parent: "/a", name: "x" },
+    )
+    expect(thrown.ok).toBe(false)
+    expect(thrown.code).toBe("call-failed")
+  })
+})
diff --git a/packages/app/src/workspaces/selection/roots.ts b/packages/app/src/workspaces/selection/roots.ts
new file mode 100644
index 0000000000..de890b46eb
--- /dev/null
+++ b/packages/app/src/workspaces/selection/roots.ts
@@ -0,0 +1,274 @@
+/**
+ * 选择工作区目录 —— 四个主目录（沙箱 / 桌面 / 文档 / 下载）的客户端策略（oc-desktop-hos 需求 203）。
+ *
+ * 本文件是 0007-workspace-roots-picker 补丁新增的唯一「逻辑」模块：把
+ * 「四个主目录」的**纯函数**（根围栏、根识别、路径裁剪、默认名去重、面包屑分段、隐藏项过滤）
+ * 与壳侧能力 RPC 的**调用封装**放在一起，使对话框组件只负责展示与交互。
+ *
+ * 能力侧由壳专用 opencode 插件 `oc-plugin-workspace-roots` 提供（`POST /api/rpc/:rpcID/:method`）：
+ *   roots / mkdir / permissionCheck / permissionRequest / openAppInfo
+ * 目录**数据**仍走上游既有 `fs/list`（`sdk.api.file.list`），本模块不自实现文件系统遍历。
+ *
+ * 自门控：`probeWorkspaceRoots` 在 RPC 不可达（未注册 / 非本壳部署 / 插件未激活）时返回
+ * `undefined`，调用方据此**完整回退上游行为**，不出现半残状态。
+ */
+
+export type RootId = "sandbox" | "desktop" | "documents" | "download"
+
+export type RootInfo = {
+  readonly id: RootId
+  /** 绝对真实路径；不可用时为空串（不用 null，规避 schema 联合类型的取值风险） */
+  readonly path: string
+  readonly available: boolean
+  /** 不可用原因（人类可读） */
+  readonly reason: string
+}
+
+export type RootSet = {
+  /** 真实家目录（诊断用；宿主注入） */
+  readonly home: string
+  readonly roots: readonly RootInfo[]
+}
+
+export type MkdirResult = {
+  readonly ok: boolean
+  readonly code: string
+  readonly message: string
+  readonly path: string
+}
+
+export type PermissionCheck = {
+  readonly granted: boolean
+  readonly source: string
+  readonly message: string
+}
+
+export type PermissionRequest = {
+  readonly code: number
+  readonly bridgeUnavailable: boolean
+  readonly message: string
+}
+
+export type AppInfoResult = {
+  readonly ok: boolean
+  readonly message: string
+}
+
+/** 壳侧能力 RPC 的 id（与 `plugins/oc-plugin-workspace-roots` 的 `definition.id` 一致） */
+export const ROOTS_RPC_ID = "oc-harmony-workspace-roots"
+
+/** 主目录顺序（与插件返回顺序、UI Tab 顺序一致） */
+export const ROOT_IDS = ["sandbox", "desktop", "documents", "download"] as const satisfies readonly RootId[]
+
+/** 主目录记忆的 localStorage 键（插件私有前缀，避免与上游键冲突） */
+export const ROOT_STORAGE_KEY = "oc-desktop.directoryPicker.root"
+
+/** 新建文件夹的默认名（中英文界面各自有文案键，此处为兜底） */
+export const DEFAULT_FOLDER_NAME = "Untitled folder"
+
+/** 需要 OS 授权的主目录（沙箱免授权） */
+export const USER_ROOT_IDS = ["desktop", "documents", "download"] as const satisfies readonly RootId[]
+
+type RpcSdk = {
+  api: {
+    rpc: {
+      call: (input: { rpcID: string; method: string; input?: unknown }) => Promise<{ output?: unknown }>
+    }
+  }
+}
+
+// ------------------------------------------------------------------ 纯函数（可单测）
+
+// 统一分隔符为 `/` 并去尾部分隔符（仅用于包含性判定；不解析 symlink、不做大小写归一）
+export function normalizeRootPath(input: string): string {
+  // 统一分隔符：根路径由 `path.join` 生成（宿主 Windows 上带 `\`），客户端目标路径恒为 `/`。
+  const value = String(input ?? "").replace(/\\/g, "/")
+  if (value.length <= 1) return value
+  return value.replace(/\/+$/, "") || "/"
+}
+
+/**
+ * `child` 是否位于 `root` 之内（含 `root` 自身）。
+ * 分隔符无关（`/` 与 `\` 都判定为子路径边界），逐段比较以避免 `/a/bc` 被 `/a/b` 命中。
+ * 不解析 symlink（应用域 symlink 不可用）。
+ */
+export function isWithin(root: string, child: string): boolean {
+  const base = normalizeRootPath(root)
+  const target = normalizeRootPath(child)
+  if (!base || !target) return false
+  if (base.split("/").includes("..") || target.split("/").includes("..")) return false
+  if (target === base) return true
+  // 统一分隔符后按 `/` 边界比较：根路径（`path.join`，宿主 Windows 上带 `\`）与客户端目标路径
+  // （上游 `canonicalPickerPath`，恒为 `/`）可能混用，单侧边界比较会假阴性（评审 Finding 1）。
+  return target.startsWith(`${base}/`)
+}
+
+/** 返回包含 `path` 的主目录（最长前缀匹配）；无匹配返回 undefined */
+export function rootOf(path: string, roots: readonly RootInfo[]): RootInfo | undefined {
+  return roots
+    .filter((root) => root.available && root.path.length > 0 && isWithin(root.path, path))
+    .sort((a, b) => b.path.length - a.path.length)
+    .at(0)
+}
+
+/** 把任意路径裁剪到 `root` 之内（不在其中则返回 `root`） */
+export function clampToRoot(root: string, path: string): string {
+  return isWithin(root, path) ? normalizeRootPath(path) : normalizeRootPath(root)
+}
+
+/** 在已有同级名称中为 `base` 选一个不冲突的名称：`base` → `base 2` → `base 3` … */
+export function defaultFolderName(existing: readonly string[], base: string): string {
+  const taken = new Set(existing.map((name) => name.trim()))
+  if (!taken.has(base)) return base
+  let index = 2
+  while (taken.has(`${base} ${index}`)) index += 1
+  return `${base} ${index}`
+}
+
+/** 从 `root` 到 `path` 的分段（不含 `root` 之上的层级）；`path` 不在 root 内时返回空数组 */
+export function crumbSegments(root: string, path: string): readonly string[] {
+  const base = normalizeRootPath(root)
+  const target = normalizeRootPath(path)
+  if (!isWithin(base, target)) return []
+  if (target === base) return []
+  return target.slice(base.length).replace(/^[/\\]+/, "").split(/[/\\]+/).filter(Boolean)
+}
+
+/** 过滤隐藏项（以 `.` 开头的最后一段）；四主目录模式不提供「显示隐藏文件」开关 */
+export function filterHiddenEntries(entries: readonly string[]): readonly string[] {
+  return entries.filter((entry) => {
+    const segments = entry.replace(/[/\\]+$/, "").split(/[/\\]+/)
+    const name = segments.at(-1) ?? ""
+    return name.length > 0 && !name.startsWith(".")
+  })
+}
+
+/** 读取记忆的主目录 id；非法值回退 `sandbox` */
+export function readStoredRootId(storage?: Pick<Storage, "getItem">): RootId {
+  try {
+    const raw = storage?.getItem(ROOT_STORAGE_KEY)
+    return ROOT_IDS.includes(raw as RootId) ? (raw as RootId) : "sandbox"
+  } catch {
+    return "sandbox"
+  }
+}
+
+/** 写入记忆的主目录 id（只记主目录，不记子路径） */
+export function writeStoredRootId(id: RootId, storage?: Pick<Storage, "setItem">): void {
+  try {
+    storage?.setItem(ROOT_STORAGE_KEY, id)
+  } catch {
+    // 存储不可用不影响本次会话
+  }
+}
+
+// ------------------------------------------------------------------ 能力 RPC 封装
+
+function asRootSet(output: unknown): RootSet | undefined {
+  if (output === null || typeof output !== "object") return undefined
+  const candidate = output as { home?: unknown; roots?: unknown }
+  if (typeof candidate.home !== "string" || !Array.isArray(candidate.roots)) return undefined
+  const roots = candidate.roots.flatMap((entry): RootInfo[] => {
+    if (entry === null || typeof entry !== "object") return []
+    const item = entry as Record<string, unknown>
+    if (typeof item.id !== "string" || !ROOT_IDS.includes(item.id as RootId)) return []
+    return [
+      {
+        id: item.id as RootId,
+        path: typeof item.path === "string" ? item.path : "",
+        available: item.available === true,
+        reason: typeof item.reason === "string" ? item.reason : "",
+      },
+    ]
+  })
+  if (roots.length === 0) return undefined
+  return { home: candidate.home, roots }
+}
+
+/**
+ * 探测四主目录能力。RPC 不可达或返回形状不符时返回 `undefined`（调用方回退上游行为）。
+ * 不抛错：能力缺失是「非本壳部署」的正常形态，不是错误。
+ */
+export async function probeWorkspaceRoots(sdk: RpcSdk): Promise<RootSet | undefined> {
+  try {
+    const result = await sdk.api.rpc.call({ rpcID: ROOTS_RPC_ID, method: "roots", input: {} })
+    return asRootSet(result.output)
+  } catch {
+    return undefined
+  }
+}
+
+/** 在主目录内新建目录；失败返回带 `code` 的结构化结果（不抛错） */
+export async function mkdirInRoot(
+  sdk: RpcSdk,
+  input: { id: RootId; parent: string; name: string },
+): Promise<MkdirResult> {
+  try {
+    const result = await sdk.api.rpc.call({ rpcID: ROOTS_RPC_ID, method: "mkdir", input })
+    const output = result.output as Partial<MkdirResult> | undefined
+    if (output && typeof output.ok === "boolean") {
+      return {
+        ok: output.ok,
+        code: typeof output.code === "string" ? output.code : "",
+        message: typeof output.message === "string" ? output.message : "",
+        path: typeof output.path === "string" ? output.path : "",
+      }
+    }
+  } catch (error) {
+    return { ok: false, code: "call-failed", message: error instanceof Error ? error.message : String(error), path: "" }
+  }
+  return { ok: false, code: "empty-output", message: "", path: "" }
+}
+
+/** 目录权限预检（桥不可用时 `source:"unavailable"`） */
+export async function checkDirectoryPermission(sdk: RpcSdk, id: RootId): Promise<PermissionCheck> {
+  try {
+    const result = await sdk.api.rpc.call({ rpcID: ROOTS_RPC_ID, method: "permissionCheck", input: { id } })
+    const output = result.output as Partial<PermissionCheck> | undefined
+    if (output && typeof output.granted === "boolean") {
+      return {
+        granted: output.granted,
+        source: typeof output.source === "string" ? output.source : "bridge",
+        message: typeof output.message === "string" ? output.message : "",
+      }
+    }
+  } catch {
+    // 落到下面的统一降级
+  }
+  return { granted: false, source: "unavailable", message: "" }
+}
+
+/**
+ * 主动申请目录权限。回调 `0` = 系统报告已授权，但**是否真的生效必须以一次全新的列举为准**
+ * （同类 PC runtime 实测可能「回调成功但不弹窗、实际访问仍被拒」）。
+ */
+export async function requestDirectoryPermission(sdk: RpcSdk, id: RootId): Promise<PermissionRequest> {
+  try {
+    const result = await sdk.api.rpc.call({ rpcID: ROOTS_RPC_ID, method: "permissionRequest", input: { id } })
+    const output = result.output as Partial<PermissionRequest> | undefined
+    if (output && typeof output.code === "number") {
+      return {
+        code: output.code,
+        bridgeUnavailable: output.bridgeUnavailable === true,
+        message: typeof output.message === "string" ? output.message : "",
+      }
+    }
+  } catch {
+    // 落到下面的统一降级
+  }
+  return { code: -1, bridgeUnavailable: true, message: "" }
+}
+
+/** 深链到本应用信息页的「文件和文件夹」权限（授权兜底路径） */
+export async function openAppPermissionSettings(sdk: RpcSdk): Promise<AppInfoResult> {
+  try {
+    const result = await sdk.api.rpc.call({ rpcID: ROOTS_RPC_ID, method: "openAppInfo", input: {} })
+    const output = result.output as Partial<AppInfoResult> | undefined
+    if (output && typeof output.ok === "boolean") {
+      return { ok: output.ok, message: typeof output.message === "string" ? output.message : "" }
+    }
+  } catch {
+    // 落到下面的统一降级
+  }
+  return { ok: false, message: "" }
+}

