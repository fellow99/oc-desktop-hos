@@ -0,0 +1,184 @@
+import { Button } from "@opencode/ui/button"
+import { createSignal, For, onMount, Show, type Component } from "solid-js"
+import { useLanguage } from "@/runtime/i18n/language"
+import "@/settings/settings.css"
+import "./git.css"
+import {
+  listGitCredentials,
+  probeGitCredentials,
+  removeGitCredential,
+  saveGitCredential,
+  validateCredentialInput,
+  type GitCredentialEntry,
+  type GitCredentialsFile,
+} from "./credentials"
+
+/** 能力可用性：`undefined` = 尚未探测；`false` = 非本壳部署（整页隐藏） */
+const [available, setAvailable] = createSignal<boolean | undefined>(undefined)
+export const gitSettingsAvailable = available
+
+/** 供 settings shell 在挂载时探测一次；失败只代表「不是本壳」，不是错误 */
+export async function probeGitSettings(sdk: { api: { rpc: { call: (input: never) => Promise<{ output?: unknown }> } } } | undefined) {
+  if (available() !== undefined) return
+  if (!sdk) {
+    setAvailable(false)
+    return
+  }
+  const described = await probeGitCredentials(sdk as never)
+  setAvailable(described !== undefined)
+}
+
+export const SettingsGit: Component<{ sdk?: unknown }> = (props) => {
+  const language = useLanguage()
+  const sdk = () => props.sdk as never
+  const [file, setFile] = createSignal<GitCredentialsFile | undefined>(undefined)
+  const [entries, setEntries] = createSignal<GitCredentialEntry[]>([])
+  const [protocol, setProtocol] = createSignal("https")
+  const [host, setHost] = createSignal("")
+  const [username, setUsername] = createSignal("")
+  const [password, setPassword] = createSignal("")
+  const [notice, setNotice] = createSignal("")
+  const [busy, setBusy] = createSignal(false)
+
+  const refresh = async () => {
+    const described = await probeGitCredentials(sdk())
+    setFile(described)
+    if (!described) {
+      setAvailable(false)
+      return
+    }
+    setAvailable(true)
+    const listed = await listGitCredentials(sdk())
+    setEntries(listed?.entries ?? [])
+  }
+
+  onMount(() => {
+    void refresh()
+  })
+
+  const save = async () => {
+    const invalid = validateCredentialInput({
+      protocol: protocol(),
+      host: host(),
+      username: username(),
+      password: password(),
+    })
+    if (invalid) {
+      setNotice(language.t("settings.git.invalid"))
+      return
+    }
+    setBusy(true)
+    const result = await saveGitCredential(sdk(), {
+      protocol: protocol(),
+      host: host().trim(),
+      username: username().trim(),
+      password: password(),
+    })
+    setBusy(false)
+    setPassword("")
+    if (!result.ok) {
+      setNotice(result.code ? `${result.code}: ${result.message}` : language.t("settings.git.invalid"))
+      return
+    }
+    await refresh()
+    setNotice(language.t("settings.git.saved"))
+  }
+
+  const remove = async (entry: GitCredentialEntry) => {
+    setBusy(true)
+    const result = await removeGitCredential(sdk(), {
+      protocol: entry.protocol,
+      host: entry.host,
+      username: entry.username,
+    })
+    setBusy(false)
+    await refresh()
+    setNotice(result.ok ? language.t("settings.git.removed") : result.code || result.message)
+  }
+
+  return (
+    <Show when={available() !== false}>
+      <div class="settings-tab-header">
+        <div class="settings-tab-header-row">
+          <div class="flex flex-col gap-1">
+            <h2 class="settings-tab-title">{language.t("settings.git.title")}</h2>
+            <span class="text-11-regular text-v2-text-text-muted">{language.t("settings.git.description")}</span>
+          </div>
+        </div>
+      </div>
+
+      <div class="git-credentials">
+        <Show when={file()}>
+          {(value) => (
+            <div class="git-credentials-path">
+              <span class="text-11-regular text-v2-text-text-muted">{language.t("settings.git.path")}</span>
+              <code>{value().path}</code>
+              <Show when={value().exists}>
+                <span class="text-11-regular text-v2-text-text-muted">
+                  {language.t("settings.git.mode")} {value().mode}
+                </span>
+              </Show>
+            </div>
+          )}
+        </Show>
+
+        <div class="git-credentials-form">
+          <label>
+            <span>{language.t("settings.git.protocol")}</span>
+            <select value={protocol()} onChange={(event) => setProtocol(event.currentTarget.value)}>
+              <option value="https">https</option>
+              <option value="http">http</option>
+            </select>
+          </label>
+          <label>
+            <span>{language.t("settings.git.host")}</span>
+            <input value={host()} onInput={(event) => setHost(event.currentTarget.value)} placeholder="git.example.com" />
+          </label>
+          <label>
+            <span>{language.t("settings.git.username")}</span>
+            <input value={username()} onInput={(event) => setUsername(event.currentTarget.value)} />
+          </label>
+          <label>
+            <span>{language.t("settings.git.password")}</span>
+            <input
+              type="password"
+              value={password()}
+              onInput={(event) => setPassword(event.currentTarget.value)}
+              autocomplete="off"
+            />
+          </label>
+          <Button size="small" disabled={busy()} onClick={() => void save()}>
+            {language.t("settings.git.save")}
+          </Button>
+        </div>
+
+        <Show when={notice()}>
+          <span class="git-credentials-notice text-11-regular">{notice()}</span>
+        </Show>
+
+        <Show when={entries().length > 0} fallback={<span class="text-11-regular text-v2-text-text-muted">{language.t("settings.git.empty")}</span>}>
+          <ul class="git-credentials-list">
+            <For each={entries()}>
+              {(entry) => (
+                <li>
+                  <div class="git-credentials-entry">
+                    <code>
+                      {entry.protocol}://{entry.host}
+                    </code>
+                    <span>{entry.username}</span>
+                    <span class="text-11-regular text-v2-text-text-muted">
+                      {language.t("settings.git.configured", { length: String(entry.passwordLength) })}
+                    </span>
+                  </div>
+                  <Button size="small" variant="ghost" disabled={busy()} onClick={() => void remove(entry)}>
+                    {language.t("settings.git.remove")}
+                  </Button>
+                </li>
+              )}
+            </For>
+          </ul>
+        </Show>
+      </div>
+    </Show>
+  )
+}
