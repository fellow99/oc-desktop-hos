diff --git a/packages/app/src/settings/git/credentials.ts b/packages/app/src/settings/git/credentials.ts
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/packages/app/src/settings/git/credentials.ts
@@ -0,0 +1,133 @@
+/**
+ * 「设置 → Git」页的 RPC 封装与纯函数（壳专用能力来自 oc-plugin-git 插件）。
+ *
+ * 边界（specs/204-plugin-git）：本页只做**凭据管理**，不承载任何 git 数据；口令只在
+ * 「输入 → 保存」这一次调用里出现，页面从不回显值（只显示长度）。
+ */
+export const GIT_RPC_ID = "oc-harmony-git"
+
+export type GitCredentialEntry = {
+  protocol: string
+  host: string
+  username: string
+  passwordLength: number
+  hasPath: boolean
+}
+
+export type GitCredentialsFile = {
+  path: string
+  exists: boolean
+  mode: string
+  count: number
+  message: string
+}
+
+export type GitRpcResult = { ok: boolean; code: string; message: string; path?: string }
+
+type RpcSdk = {
+  api: { rpc: { call: (input: { rpcID: string; method: string; input?: unknown }) => Promise<{ output?: unknown }> } }
+}
+
+const asString = (value: unknown) => (typeof value === "string" ? value : "")
+
+function asEntry(value: unknown): GitCredentialEntry | undefined {
+  if (!value || typeof value !== "object") return undefined
+  const item = value as Record<string, unknown>
+  if (typeof item.host !== "string" || item.host.length === 0) return undefined
+  return {
+    protocol: asString(item.protocol) || "https",
+    host: item.host,
+    username: asString(item.username),
+    passwordLength: typeof item.passwordLength === "number" ? item.passwordLength : 0,
+    hasPath: item.hasPath === true,
+  }
+}
+
+function asFile(value: unknown): GitCredentialsFile | undefined {
+  if (!value || typeof value !== "object") return undefined
+  const item = value as Record<string, unknown>
+  if (typeof item.path !== "string") return undefined
+  return {
+    path: item.path,
+    exists: item.exists === true,
+    mode: asString(item.mode),
+    count: typeof item.count === "number" ? item.count : 0,
+    message: asString(item.message),
+  }
+}
+
+function asResult(value: unknown): GitRpcResult {
+  if (!value || typeof value !== "object") return { ok: false, code: "rpc.unavailable", message: "" }
+  const item = value as Record<string, unknown>
+  return {
+    ok: item.ok === true,
+    code: asString(item.code),
+    message: asString(item.message),
+    path: typeof item.path === "string" ? item.path : undefined,
+  }
+}
+
+/** 探测凭据能力：RPC 不可达时返回 `undefined`（调用方把整页隐藏，不算错误） */
+export async function probeGitCredentials(sdk: RpcSdk): Promise<GitCredentialsFile | undefined> {
+  try {
+    const result = await sdk.api.rpc.call({ rpcID: GIT_RPC_ID, method: "credentials.describe", input: {} })
+    return asFile(result.output)
+  } catch {
+    return undefined
+  }
+}
+
+/** 列出已配置的凭据（永不包含口令） */
+export async function listGitCredentials(
+  sdk: RpcSdk,
+): Promise<{ path: string; entries: GitCredentialEntry[] } | undefined> {
+  try {
+    const result = await sdk.api.rpc.call({ rpcID: GIT_RPC_ID, method: "credentials.list", input: {} })
+    const output = result.output as Record<string, unknown> | undefined
+    if (!output || typeof output.path !== "string") return undefined
+    const entries = Array.isArray(output.entries)
+      ? output.entries.map(asEntry).filter((entry): entry is GitCredentialEntry => entry !== undefined)
+      : []
+    return { path: output.path, entries }
+  } catch {
+    return undefined
+  }
+}
+
+export async function saveGitCredential(
+  sdk: RpcSdk,
+  input: { protocol: string; host: string; username: string; password: string },
+): Promise<GitRpcResult> {
+  try {
+    const result = await sdk.api.rpc.call({ rpcID: GIT_RPC_ID, method: "credentials.save", input })
+    return asResult(result.output)
+  } catch {
+    return { ok: false, code: "rpc.unavailable", message: "" }
+  }
+}
+
+export async function removeGitCredential(
+  sdk: RpcSdk,
+  input: { protocol: string; host: string; username: string },
+): Promise<GitRpcResult> {
+  try {
+    const result = await sdk.api.rpc.call({ rpcID: GIT_RPC_ID, method: "credentials.remove", input })
+    return asResult(result.output)
+  } catch {
+    return { ok: false, code: "rpc.unavailable", message: "" }
+  }
+}
+
+/** 表单校验（主机/用户名/口令都必填；协议只允许 http/https） */
+export function validateCredentialInput(input: {
+  protocol: string
+  host: string
+  username: string
+  password: string
+}): string | undefined {
+  if (input.protocol !== "http" && input.protocol !== "https") return "invalid-protocol"
+  if (input.host.trim().length === 0) return "invalid-host"
+  if (input.username.trim().length === 0) return "invalid-username"
+  if (input.password.length === 0) return "invalid-password"
+  return undefined
+}
diff --git a/packages/app/src/settings/git/git.tsx b/packages/app/src/settings/git/git.tsx
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/packages/app/src/settings/git/git.tsx
@@ -0,0 +1,185 @@
+import { Button } from "@opencode/ui/button"
+import { createSignal, For, onMount, Show, type Component } from "solid-js"
+import { useLanguage } from "@/runtime/i18n/language"
+import "@/settings/settings.css"
+import "./git.css"
+import {
+  listGitCredentials,
+  probeGitCredentials,
+  removeGitCredential,
+  saveGitCredential,
+  validateCredentialInput,
+  type GitCredentialEntry,
+  type GitCredentialsFile,
+} from "./credentials"
+
+/** 能力可用性：`undefined` = 尚未探测；`false` = 非本壳部署（整页隐藏） */
+const [available, setAvailable] = createSignal<boolean | undefined>(undefined)
+export const gitSettingsAvailable = available
+
+/**
+ * 供 settings shell 在 sdk 就绪后探测一次；失败只代表「不是本壳」，不是错误。
+ *
+ * `sdk` 缺失时**不落 false**：那只是「服务还没就绪」，落 false 会被 latch 住，Tab 永远不出现。
+ */
+export async function probeGitSettings(sdk: { api: { rpc: { call: (input: never) => Promise<{ output?: unknown }> } } } | undefined) {
+  if (available() !== undefined) return
+  if (!sdk) return
+  const described = await probeGitCredentials(sdk as never)
+  setAvailable(described !== undefined)
+}
+
+export const SettingsGit: Component<{ sdk?: unknown }> = (props) => {
+  const language = useLanguage()
+  const sdk = () => props.sdk as never
+  const [file, setFile] = createSignal<GitCredentialsFile | undefined>(undefined)
+  const [entries, setEntries] = createSignal<GitCredentialEntry[]>([])
+  const [protocol, setProtocol] = createSignal("https")
+  const [host, setHost] = createSignal("")
+  const [username, setUsername] = createSignal("")
+  const [password, setPassword] = createSignal("")
+  const [notice, setNotice] = createSignal("")
+  const [busy, setBusy] = createSignal(false)
+
+  const refresh = async () => {
+    const described = await probeGitCredentials(sdk())
+    setFile(described)
+    if (!described) {
+      setAvailable(false)
+      return
+    }
+    setAvailable(true)
+    const listed = await listGitCredentials(sdk())
+    setEntries(listed?.entries ?? [])
+  }
+
+  onMount(() => {
+    void refresh()
+  })
+
+  const save = async () => {
+    const invalid = validateCredentialInput({
+      protocol: protocol(),
+      host: host(),
+      username: username(),
+      password: password(),
+    })
+    if (invalid) {
+      setNotice(language.t("settings.git.invalid"))
+      return
+    }
+    setBusy(true)
+    const result = await saveGitCredential(sdk(), {
+      protocol: protocol(),
+      host: host().trim(),
+      username: username().trim(),
+      password: password(),
+    })
+    setBusy(false)
+    setPassword("")
+    if (!result.ok) {
+      setNotice(result.code ? `${result.code}: ${result.message}` : language.t("settings.git.invalid"))
+      return
+    }
+    await refresh()
+    setNotice(language.t("settings.git.saved"))
+  }
+
+  const remove = async (entry: GitCredentialEntry) => {
+    setBusy(true)
+    const result = await removeGitCredential(sdk(), {
+      protocol: entry.protocol,
+      host: entry.host,
+      username: entry.username,
+    })
+    setBusy(false)
+    await refresh()
+    setNotice(result.ok ? language.t("settings.git.removed") : result.code || result.message)
+  }
+
+  return (
+    <Show when={available() !== false}>
+      <div class="settings-tab-header">
+        <div class="settings-tab-header-row">
+          <div class="flex flex-col gap-1">
+            <h2 class="settings-tab-title">{language.t("settings.git.title")}</h2>
+            <span class="text-11-regular text-v2-text-text-muted">{language.t("settings.git.description")}</span>
+          </div>
+        </div>
+      </div>
+
+      <div class="git-credentials">
+        <Show when={file()}>
+          {(value) => (
+            <div class="git-credentials-path">
+              <span class="text-11-regular text-v2-text-text-muted">{language.t("settings.git.path")}</span>
+              <code>{value().path}</code>
+              <Show when={value().exists}>
+                <span class="text-11-regular text-v2-text-text-muted">
+                  {language.t("settings.git.mode")} {value().mode}
+                </span>
+              </Show>
+            </div>
+          )}
+        </Show>
+
+        <div class="git-credentials-form">
+          <label>
+            <span>{language.t("settings.git.protocol")}</span>
+            <select value={protocol()} onChange={(event) => setProtocol(event.currentTarget.value)}>
+              <option value="https">https</option>
+              <option value="http">http</option>
+            </select>
+          </label>
+          <label>
+            <span>{language.t("settings.git.host")}</span>
+            <input value={host()} onInput={(event) => setHost(event.currentTarget.value)} placeholder="git.example.com" />
+          </label>
+          <label>
+            <span>{language.t("settings.git.username")}</span>
+            <input value={username()} onInput={(event) => setUsername(event.currentTarget.value)} />
+          </label>
+          <label>
+            <span>{language.t("settings.git.password")}</span>
+            <input
+              type="password"
+              value={password()}
+              onInput={(event) => setPassword(event.currentTarget.value)}
+              autocomplete="off"
+            />
+          </label>
+          <Button size="small" disabled={busy()} onClick={() => void save()}>
+            {language.t("settings.git.save")}
+          </Button>
+        </div>
+
+        <Show when={notice()}>
+          <span class="git-credentials-notice text-11-regular">{notice()}</span>
+        </Show>
+
+        <Show when={entries().length > 0} fallback={<span class="text-11-regular text-v2-text-text-muted">{language.t("settings.git.empty")}</span>}>
+          <ul class="git-credentials-list">
+            <For each={entries()}>
+              {(entry) => (
+                <li>
+                  <div class="git-credentials-entry">
+                    <code>
+                      {entry.protocol}://{entry.host}
+                    </code>
+                    <span>{entry.username}</span>
+                    <span class="text-11-regular text-v2-text-text-muted">
+                      {language.t("settings.git.configured", { length: String(entry.passwordLength) })}
+                    </span>
+                  </div>
+                  <Button size="small" variant="ghost" disabled={busy()} onClick={() => void remove(entry)}>
+                    {language.t("settings.git.remove")}
+                  </Button>
+                </li>
+              )}
+            </For>
+          </ul>
+        </Show>
+      </div>
+    </Show>
+  )
+}
