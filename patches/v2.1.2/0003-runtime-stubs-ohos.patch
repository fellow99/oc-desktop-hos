+++ b/packages/core/src/persistent-pty/binary.ohos.ts
@@ -0,0 +1,22 @@
+/**
+ * HarmonyOS (`ohos`) variant of `#persistent-pty-binary` — `packages/core/package.json` maps the
+ * `ohos` condition here, and the CLI build puts `"ohos"` ahead of `"node"` in `resolve.conditions`.
+ *
+ * `binary.node.ts` hands `resolveBinary()` to the persistent-PTY transport, which spawns that
+ * binary: on HarmonyOS there is nothing to spawn. `opencode-pty` ships no ohos artifact, and a
+ * bundled ELF cannot be executed from the app sandbox (harmless-but-required stubbing, see
+ * docs/工程规划-V2.md §3.6 / §7.4b). `available = false` lets callers skip the daemon transport
+ * instead of failing at spawn time, and `resolveBinary()` reports the real reason when they do not.
+ *
+ * The variant also keeps this module free of native loads, matching the `pty.ohos.ts` rationale:
+ * any top-level load of a glibc `.node`/ELF in the `#pty` family would abort the entire bundle
+ * import.
+ */
+export const available = false
+
+export async function resolveBinary(): Promise<string> {
+  throw new Error(
+    "Persistent PTYs are unavailable on HarmonyOS: opencode-pty ships no ohos artifact and the " +
+      "platform denies executing a bundled ELF from the app sandbox",
+  )
+}
