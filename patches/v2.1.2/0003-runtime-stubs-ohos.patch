+++ b/packages/core/src/pty/pty.ohos.ts
@@ -0,0 +1,34 @@
+/**
+ * HarmonyOS (`ohos`) variant of `#pty` — `packages/core/package.json` maps the `ohos` condition
+ * here, and the CLI build puts `"ohos"` ahead of `"node"` in `resolve.conditions`.
+ *
+ * This stub is mandatory, not an optimization: `pty.node.ts` loads its backend eagerly at module
+ * top level with
+ *
+ *   const pty = createRequire(import.meta.url)(process.env.OPENCODE_NODE_PTY_PATH ?? "@lydell/node-pty")
+ *
+ * `@lydell/node-pty` has no HarmonyOS build (it ships glibc/musl `.node` addons), so that call
+ * throws while the bundle is being imported — and because `pty.ts` reaches it through
+ * `lazy(() => import("#pty"))` inside the module graph, a failed import aborts the whole bundle
+ * instead of failing one feature. Keeping this variant free of native loads turns a hard startup
+ * failure into a terminal-only failure.
+ *
+ * Terminals are unavailable at the platform level on HarmonyOS: SELinux denies forkpty/openpty/popen
+ * for the app process (docs/工程规划-V2.md §7.4b), so there is no fallback to implement — spawning
+ * always throws, and `available` documents the capability for anything that wants to probe it.
+ */
+import type { Opts, Proc } from "./pty.js"
+
+export type { Disp, Exit, Opts, Proc } from "./pty.js"
+
+export const available = false
+
+export function spawn(file: string, args: string[], opts: Opts): Proc {
+  void file
+  void args
+  void opts
+  throw new Error(
+    "Pseudo-terminals are unavailable on HarmonyOS: the platform denies forkpty/openpty/popen (SELinux), " +
+      "and neither @lydell/node-pty nor the opencode-pty helper ships an ohos build",
+  )
+}
