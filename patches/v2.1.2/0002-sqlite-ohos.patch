+/**
+ * HarmonyOS (`ohos`) variant of `#sqlite`.
+ *
+ * `packages/core/package.json` maps the `ohos` condition here and the CLI build puts `"ohos"` ahead
+ * of `"node"` in `resolve.conditions`, so an ohos build never reaches the upstream `node` variant.
+ *
+ * Why it exists: `sqlite.node.ts` opens `node:sqlite`'s `DatabaseSync`, but the HarmonyOS runtime
+ * ships a customized Node without the sqlite binding — there, even importing `node:sqlite` fails
+ * with `No such binding: sqlite`. This file therefore never references that module statically;
+ * both backends are pulled in with `require` at runtime. Only on a host (Electron 37 / Node 22.17,
+ * see `oc-desktop-hos/scripts/smoke-node22.mjs`) does `node:sqlite` exist at all.
+ *
+ * Backend loading is two-tier, tried in order:
+ *   1. `require(process.env.OPENCODE_BETTER_SQLITE3_PATH ?? "better-sqlite3")` — the device path.
+ *      The JS half of better-sqlite3 ships inside the materialized runtime tree next to the bundle
+ *      (so a bare specifier resolves), and the native half is deployed from `electron/libs/arm64-v8a/`
+ *      into `/data/storage/el1/bundle/libs/arm64/`: a `.node` extracted into the app data directory
+ *      cannot be dlopen'ed, so the environment variable carries its absolute path. It may point at
+ *      the module directory or straight at `better_sqlite3.node` (see docs/工程规划-V2.md §3.6).
+ *   2. `node:sqlite`'s `DatabaseSync` — host-side fallback only, reached when tier 1 throws. On a
+ *      device the binding is absent, so a tier 2 failure reports both backends and both reasons.
+ *
+ * better-sqlite3 is adapted onto the `node:sqlite` surface so the body below matches
+ * `sqlite.node.ts`:
+ *   new Database(filename, { readonly, timeout, fileMustExist })  ~  new DatabaseSync(filename, ...)
+ *   statement.safeIntegers(true)                                  ~  statement.setReadBigInts(true)
+ *   statement.raw(true)                                           ~  statement.setReturnArrays(true)
+ *   statement.all(...) / database.exec() / database.loadExtension() / database.pragma() / close()
+ */
+import { createRequire } from "node:module"
+import { Context, Effect, Layer } from "effect"
+import { Reactivity } from "effect/unstable/reactivity"
+import { SqlClient } from "effect/unstable/sql"
+import { classifySqliteError, SqlError } from "effect/unstable/sql/SqlError"
+import { Sqlite } from "./sqlite.js"
+
+const TypeId = "~@opencode/core/database/SqliteOhos" as const
+
+export const supportsTuningPragmas = true
+
+// Foreign keys default OFF and can be toggled per connection.
+export const supportsForeignKeyToggle = true
+
+interface Config extends Sqlite.ClientConfig {
+  readonly filename: string
+  readonly readonly?: boolean
+  readonly create?: boolean
+  readonly readwrite?: boolean
+  readonly disableWAL?: boolean
+  readonly timeout?: number
+  readonly allowExtension?: boolean
+}
+
+/** The statement surface both backends are normalized onto. */
+interface SyncStatement {
+  setReadBigInts(enabled: boolean): void
+  setReturnArrays(enabled: boolean): void
+  all(...params: unknown[]): Array<Record<string, unknown>>
+}
+
+/** The database surface both backends are normalized onto. */
+interface SyncDatabase {
+  prepare(query: string): SyncStatement
+  exec(sql: string): void
+  loadExtension(path: string): void
+  pragma(source: string): void
+  close(): void
+}
+
+interface BetterSqlite3Statement {
+  /** false = 该语句不返回数据（PRAGMA 赋值 / DDL 等）：better-sqlite3 的 all() 会抛错，需走 run() */
+  readonly reader: boolean
+  safeIntegers(enabled: boolean): unknown
+  raw(enabled: boolean): unknown
+  all(...params: unknown[]): Array<Record<string, unknown>>
+  run(...params: unknown[]): unknown
+}
+
+interface BetterSqlite3Database {
+  prepare(query: string): BetterSqlite3Statement
+  exec(sql: string): void
+  loadExtension(path: string): void
+  pragma(source: string, options?: { simple?: boolean }): unknown
+  close(): void
+}
+
+type BetterSqlite3Constructor = new (
+  filename: string,
+  options?: { readonly?: boolean; timeout?: number; fileMustExist?: boolean },
+) => BetterSqlite3Database
+
+// Resolved against the bundle, so a bare specifier finds the `node_modules` shipped with it.
+const require = createRequire(import.meta.url)
+
+function openBetterSqlite3(specifier: string, config: Config): SyncDatabase {
+  const Database = require(specifier) as BetterSqlite3Constructor
+  const database = new Database(config.filename, {
+    readonly: config.readonly === true,
+    // better-sqlite3 的选项校验会拒绝「存在但为 undefined」的 timeout，因此仅在传入正整数时才带上该键；
+    // 缺省时由 better-sqlite3 使用自己的默认值（5000ms），比传 0 更适合设备。
+    ...(typeof config.timeout === "number" && Number.isInteger(config.timeout) && config.timeout > 0
+      ? { timeout: config.timeout }
+      : {}),
+    // opencode's `create: false` means "do not create a missing database" -> `fileMustExist`.
+    fileMustExist: config.create === false,
+  })
+  // better-sqlite3 leaves foreign keys OFF, the upstream node variant enables them at open.
+  database.pragma("foreign_keys = ON")
+  return {
+    prepare: (query) => {
+      const statement = database.prepare(query)
+      return {
+        setReadBigInts: (enabled) => {
+          statement.safeIntegers(enabled)
+        },
+        setReturnArrays: (enabled) => {
+          // better-sqlite3 only implements the enabling direction.
+          if (enabled) statement.raw(true)
+        },
+        // 语义必须与 node:sqlite 对齐：node 的 all() 对「不返回数据」的语句返回 []，而 better-sqlite3 会抛
+        // "This statement does not return data. Use run() instead"。设备侧 sqlite 变体走 better-sqlite3，
+        // 不对齐会让服务端启动时的 `PRAGMA synchronous = NORMAL` 直接失败（真机实测：cli process failed）。
+        // 注意：aarch64-ohos / ABI v138 的 better-sqlite3 构建未暴露可用的 reader 标志（真机实测
+        // reader === false 判据不成立），因此以「错误语义」兜底，而不依赖该属性。
+        all: (...params) => {
+          if (statement.reader === false) {
+            statement.run(...params)
+            return []
+          }
+          try {
+            return statement.all(...params)
+          } catch (error) {
+            if (/does not return data/i.test(String((error as Error)?.message ?? error))) {
+              statement.run(...params)
+              return []
+            }
+            throw error
+          }
+        },
+      }
+    },
+    exec: (sql) => database.exec(sql),
+    loadExtension: (path) => database.loadExtension(path),
+    pragma: (source) => {
+      database.pragma(source)
+    },
+    close: () => database.close(),
+  }
+}
+
+/**
+ * 加载 node:sqlite（tier 2，仅用于 host 侧门禁）。
+ * 优先用 process.getBuiltinModule（Node ≥22.3）：它直接返回 builtin，绕开 ESM/CJS 加载器，
+ * 因而不会被产物前导通过 module.registerHooks 注册的模块钩子干扰（否则会报
+ * "load hook returned null for source"）。缺省时退回普通 require。
+ */
+function loadNodeSqlite(): Record<string, unknown> {
+  const getBuiltin = (process as unknown as { getBuiltinModule?: (id: string) => unknown }).getBuiltinModule
+  if (typeof getBuiltin === "function") return getBuiltin("node:sqlite") as Record<string, unknown>
+  return require("node:sqlite") as Record<string, unknown>
+}
+
+function openNodeSqlite(config: Config): SyncDatabase {
+  const { DatabaseSync } = loadNodeSqlite() as {
+    DatabaseSync: new (
+      filename: string,
+      options?: {
+        readOnly?: boolean
+        timeout?: number
+        allowExtension?: boolean
+        enableForeignKeyConstraints?: boolean
+        open?: boolean
+      },
+    ) => {
+      prepare(query: string): {
+        setReadBigInts(enabled: boolean): void
+        setReturnArrays(enabled: boolean): void
+        all(...params: unknown[]): Array<Record<string, unknown>>
+      }
+      exec(sql: string): void
+      loadExtension(path: string): void
+      close(): void
+    }
+  }
+  const database = new DatabaseSync(config.filename, {
+    readOnly: config.readonly,
+    timeout: config.timeout,
+    allowExtension: config.allowExtension,
+    enableForeignKeyConstraints: true,
+    open: true,
+  })
+  return {
+    prepare: (query) => database.prepare(query),
+    exec: (sql) => database.exec(sql),
+    loadExtension: (path) => database.loadExtension(path),
+    pragma: (source) => {
+      database.exec(`PRAGMA ${source}`)
+    },
+    close: () => database.close(),
+  }
+}
+
+function reason(error: unknown) {
+  return error instanceof Error ? error.message : String(error)
+}
+
+function open(config: Config): SyncDatabase {
+  const specifier = process.env.OPENCODE_BETTER_SQLITE3_PATH ?? "better-sqlite3"
+  try {
+    return openBetterSqlite3(specifier, config)
+  } catch (betterSqlite3) {
+    try {
+      return openNodeSqlite(config)
+    } catch (nodeSqlite) {
+      throw new Error(
+        `Failed to open SQLite database ${config.filename}: neither backend is available.\n` +
+          `  better-sqlite3 (${specifier}): ${reason(betterSqlite3)}\n` +
+          `  node:sqlite (DatabaseSync): ${reason(nodeSqlite)}\n` +
+          "On HarmonyOS the sqlite binding is missing entirely: ship the aarch64-ohos " +
+          "better_sqlite3.node from electron/libs/arm64-v8a/ and point OPENCODE_BETTER_SQLITE3_PATH " +
+          "at it (it cannot be dlopen'ed from the extracted resfile tree).",
+      )
+    }
+  }
+}
+
+const make = (options: Config) =>
+  Effect.gen(function* () {
+    const native = (yield* Sqlite.Native) as SyncDatabase
+
+    const run = (query: string, params: ReadonlyArray<unknown> = []) =>
+      Effect.withFiber<Array<Record<string, unknown>>, SqlError>((fiber) => {
+        const statement = native.prepare(query)
+        statement.setReadBigInts(Context.get(fiber.context, SqlClient.SafeIntegers))
+        try {
+          return Effect.succeed(statement.all(...params) as Array<Record<string, unknown>>)
+        } catch (cause) {
+          return Effect.fail(
+            new SqlError({
+              reason: classifySqliteError(cause, { message: "Failed to execute statement", operation: "execute" }),
+            }),
+          )
+        }
+      })
+
+    const runValues = (query: string, params: ReadonlyArray<unknown> = []) =>
+      Effect.withFiber<ReadonlyArray<ReadonlyArray<unknown>>, SqlError>((fiber) => {
+        const statement = native.prepare(query)
+        statement.setReadBigInts(Context.get(fiber.context, SqlClient.SafeIntegers))
+        statement.setReturnArrays(true)
+        try {
+          return Effect.succeed(statement.all(...params) as unknown as ReadonlyArray<ReadonlyArray<unknown>>)
+        } catch (cause) {
+          return Effect.fail(
+            new SqlError({
+              reason: classifySqliteError(cause, { message: "Failed to execute statement", operation: "execute" }),
+            }),
+          )
+        }
+      })
+
+    const connection = Sqlite.makeConnection(run, runValues, {
+      loadExtension: (path: string) =>
+        Effect.try({
+          try: () => native.loadExtension(path),
+          catch: (cause) =>
+            new SqlError({
+              reason: classifySqliteError(cause, { message: "Failed to load extension", operation: "loadExtension" }),
+            }),
+        }),
+    })
+
+    return yield* Sqlite.makeClient(options, connection, TypeId, (acquirer) => ({
+      loadExtension: (path: string) => Effect.flatMap(acquirer, (_) => _.loadExtension(path)),
+    }))
+  })
+
+const nativeLayer = (config: Config) =>
+  Layer.effect(
+    Sqlite.Native,
+    Effect.gen(function* () {
+      const native = open(config)
+      yield* Effect.addFinalizer(() => Effect.sync(() => native.close()))
+      if (config.disableWAL !== true && config.readonly !== true) native.pragma("journal_mode = WAL")
+      return native
+    }),
+  )
+
+const clientLayer = (config: Config) => Layer.effect(SqlClient.SqlClient, make(config))
+
+export const sqliteLayer = (config: Config) => {
+  const native = nativeLayer(config)
+  return Layer.merge(native, clientLayer(config).pipe(Layer.provide(native))).pipe(Layer.provide(Reactivity.layer))
+}
