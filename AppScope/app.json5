{
  "app": {
    "bundleName": "org.fellow99.oc.OCDesktop",
    "vendor": "fellow99",
    // 版本规则（与 pi-desktop-hos 一致）：versionCode = major*10000 + minor*100 + patch
    // 2.2.5 → 2*10000 + 2*100 + 5 = 20205
    "versionCode": 20205,
    "versionName": "2.2.5",
    "icon": "$media:app_icon",
    "label": "$string:app_name",
    "configuration": "$profile:configuration",
    "multiAppMode": {
      "multiAppModeType": "multiInstance",
      "maxCount": 1
    }
  }
}
